create or replace function public.member_checkin(
  p_identifier text,
  p_pin text
)
returns text
language plpgsql
security definer
set search_path = ''
as $$
declare
  v_member_id uuid;
  v_rows integer;
begin
  if p_pin !~ '^[0-9]{4,8}$' then
    return 'Invalid Member ID, Mobile or PIN';
  end if;

  select m.id into v_member_id
  from public.members m
  where (m.member_id = trim(p_identifier)
      or m.mobile = trim(p_identifier))
    and m.pin_hash = extensions.crypt(p_pin, m.pin_hash)
    and m.status = 'Active'
  limit 1;

  if v_member_id is null then
    return 'Invalid Member ID, Mobile or PIN';
  end if;

  insert into public.attendance (member_id, attendance_date)
  values (
    v_member_id,
    (now() at time zone 'Asia/Kolkata')::date
  )
  on conflict (member_id, attendance_date) do nothing;

  get diagnostics v_rows = row_count;

  if v_rows = 0 then
    return 'Already checked in today';
  end if;

  return 'Attendance marked successfully';
end;
$$;

revoke all on function public.member_checkin(text, text)
from public;

grant execute on function public.member_checkin(text, text)
to anon, authenticated;
